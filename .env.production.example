# AYSEL — production environment template (Cloud Run oriented).
# Feed these via your deploy pipeline (see deploy/cloudbuild.yaml) or
# `gcloud run services update --set-env-vars`. Never commit real secrets.

# --- Runtime ---
# production enables fail-fast config validation at boot.
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- GCP / Vertex AI ---
# On Cloud Run no key file is needed: the runtime service account
# (roles/aiplatform.user) provides Vertex AI access.
# GOOGLE_APPLICATION_CREDENTIALS is only for local/VM runs.
GOOGLE_CLOUD_PROJECT=your-project-id
AGENT_MODEL=gemini-3.5-flash

# --- Database (durable task state) ---
# Cloud SQL Postgres via the Cloud Run connector (unix socket):
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# Remember: run `alembic upgrade head` against this database once, e.g. from a
# Cloud Shell with the Cloud SQL proxy, before pointing the service at it.

# --- Redis (Celery broker + SSE event bus fan-out) ---
# Memorystore is only reachable from inside VPC. If unreachable, the event bus
# falls back to in-process queues (fine for single-instance deployments).
REDIS_URL=redis://10.0.0.10:6379/0
# true when running a separate Celery worker deployment
USE_CELERY=false

# --- Auth ---
# Enable in production; generate the secret with: openssl rand -hex 32
AUTH_ENABLED=true
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

# --- Endpoint ---
# Set to the service's public URL so the Agent Card is accurate
# (the Cloud Build pipeline patches this automatically after deploy).
A2A_ENDPOINT_URL=https://aysel-xxxxxx-uc.a.run.app
MAX_TASK_TIMEOUT=300
SSE_HEARTBEAT_SECONDS=15
