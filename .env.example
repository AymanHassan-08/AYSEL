# Copy to .env and fill in real values. Never commit .env.

# GCP / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
AGENT_MODEL=gemini-3.5-flash

# Database
DATABASE_URL=sqlite+aiosqlite:///./aysel.db

# Redis (Celery broker + event bus for SSE fan-out). Empty disables Redis.
REDIS_URL=redis://localhost:6379/0

# When true, tasks are executed by the Celery worker instead of in-process.
USE_CELERY=false

# Auth
AUTH_ENABLED=false
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_AUDIENCE=

# Endpoint
A2A_ENDPOINT_URL=http://localhost:8000
MAX_TASK_TIMEOUT=300
